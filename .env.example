# Required. Create a unique value with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-the-generated-base64-key

# Required dependency connections.
DATABASE_URL=postgres://proxy_sampler:proxy_sampler@localhost:5432/proxy_sampler?sslmode=disable
CLICKHOUSE_DSN=clickhouse://localhost:9000/proxy_sampler

# Application defaults.
HTTP_ADDR=:8080
ENRICH_CONCURRENCY=2
REPUTATION_TTL=24h
PROBE_TARGET_DEFAULT=https://speed.cloudflare.com/cdn-cgi/trace
DB_AUTO_MIGRATE=true

# Optional. Empty disables OTLP/HTTP traces, metrics, and logs.
OTEL_EXPORTER_OTLP_ENDPOINT=
